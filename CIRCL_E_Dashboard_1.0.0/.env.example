# CIRCL-E Dashboard deployment configuration.
#
# Docker: set the host paths below, then `docker compose up --build`.
# Local Python: set CIRCL_DINO_DIR / CIRCL_CRADIO_DIR instead (see README).

# Absolute host path to the frozen DINOv3 model directory (mounted read-only).
CIRCL_DINO_HOST_DIR=

# Absolute host path to the frozen C-RADIOv4 model directory (mounted read-only).
CIRCL_CRADIO_HOST_DIR=

# Host port for the dashboard.
CIRCLE_PORT=8501
